# ==============================================================
# Coffer — self-hosted x402 payment facilitator. Deploy config.
# Copy to `.env`:  cp .env.example .env  → fill REQUIRED → `make up`
# Every var Coffer reads is documented below. Marking: REQUIRED | OPTIONAL.
# ==============================================================

# ── REQUIRED: receiving wallets ────────────────────────────────
# EVM receiving address (Base USDC is the default eip155:8453 rail).
# This is THE payee — set it to the real treasury (reference the secret NAME
# `rmi/pry/x402_payee_addr`; never hardcode a value in the repo). Coffer treats
# its CONFIGURED_WALLET sentinel, "", and "coffer-unconfigured-wallet" as
# UNCONFIGURED and fails closed — never ship payments to the sentinel.
X402_WALLET=                         # REQUIRED — at least one wallet must be set
# Solana receiving wallet (base58) for USDC on solana:mainnet.
X402_WALLET_SOLANA=                  # REQUIRED only if you serve Solana USDC
# Per-network (CAIP-2) overrides — default to X402_WALLET when omitted.
X402_WALLET_BASE=                    # OPTIONAL  eip155:8453
X402_WALLET_ETH=                     # OPTIONAL  eip155:1
X402_WALLET_ARBITRUM=                # OPTIONAL  eip155:42161
X402_WALLET_OPTIMISM=                # OPTIONAL  eip155:10
X402_WALLET_POLYGON=                 # OPTIONAL  eip155:137
X402_WALLET_TRON=                    # OPTIONAL  tron:mainnet

# ── REQUIRED: redis (nonce/replay store) ───────────────────────
REDIS_URL=                           # REQUIRED  e.g. redis://redis:6379/0 (compose sets it)

# ── Self-hosted facilitation ───────────────────────────────────
# Serve the facilitator yourself ("self facilitator") vs. delegate to a
# third-party facilitator (Coinbase / PayAI / Cloudflare below).
X402_SELF_FACILITATE=1               # OPTIONAL  "1"/"true" → self-hosted (default on)
X402_SELF_FACILITATOR_KEY=           # OPTIONAL  EVM private key (hex 0x…) for on-chain settle
X402_SELF_FACILITATOR_RPC=           # OPTIONAL  EVM RPC URL used for settlement
X402_OFFLINE_MODE=0                  # OPTIONAL  "1" → never submit/verify on-chain (tests/dev)

# ── Third-party facilitators (used only when X402_SELF_FACILITATE=0) ─
X402_COINBASE_VERIFY=https://x402.org/facilitator/verify   # OPTIONAL  Coinbase verify endpoint
X402_COINBASE_SETTLE=https://x402.org/facilitator/settle   # OPTIONAL  Coinbase settle endpoint
X402_COINBASE_ENABLED=true           # OPTIONAL
X402_COINBASE_PRIORITY=1             # OPTIONAL
X402_COINBASE_API_KEY=               # OPTIONAL  Coinbase facilitator API key
X402_PAYAI_VERIFY=https://facilitator.payai.network/verify  # OPTIONAL  PayAI verify endpoint
X402_PAYAI_SETTLE=https://facilitator.payai.network/settle  # OPTIONAL  PayAI settle endpoint
X402_PAYAI_ENABLED=true              # OPTIONAL
X402_PAYAI_PRIORITY=2                # OPTIONAL
X402_CF_VERIFY=                      # OPTIONAL  Cloudflare facilitator verify URL
X402_CF_SETTLE=                      # OPTIONAL  Cloudflare facilitator settle URL
X402_CF_ENABLED=false                # OPTIONAL  Cloudflare facilitator off by default
X402_CF_PRIORITY=3                   # OPTIONAL

# ── External x402-coffer facilitator (payment-gate source of truth) ─
# The x402 MCP gateway delegates payment verification + settlement to the
# self-hosted x402-coffer facilitator over HTTP instead of verifying in-house.
# Endpoints called: POST <url>/v1/x402/verify and POST <url>/v1/x402/settle.
# FAILS CLOSED: if this facilitator is unreachable, payment-gated calls are
# rejected with 402 — never allowed through unverified.
X402_FACILITATOR_URL=http://localhost:8670  # OPTIONAL  default = local x402-coffer

# ── Protocol / expiry / tuning ─────────────────────────────────
X402_TIMEOUT_SECONDS=15              # OPTIONAL  outbound HTTP/verification timeout
X402_NONCE_TTL=86400                 # OPTIONAL  self-facilitator nonce TTL (seconds)
X402_PAYMENT_TTL=3600                # OPTIONAL  verified X-Payment-ID validity (seconds)
X402_SOLANA_RPC=                     # OPTIONAL  Solana RPC URL (defaults to public RPC)
X402_DEFAULT_NETWORK=eip155:8453     # OPTIONAL  network used when none is offered
X402_EIP712_NAME=USD Coin            # OPTIONAL  EIP-712 domain name
X402_EIP712_VERSION=2                # OPTIONAL  EIP-712 domain version
X402_PRICING_JSON=                   # OPTIONAL  JSON override of the whole pricing table
# Per-asset live USD price override. Coffer names these X402_<ASSET>_USD
# (stablecoins are 1:1 and need no override). e.g. X402_ETH_USD=3500
X402_USDC_USD=                       # OPTIONAL  X402_<ASSET>_USD pattern
# Per-network EIP-7702 RPC override: X402_EIP7702_RPC_<NETWORKSUFFIX>
X402_EIP7702_RPC_BASE=               # OPTIONAL  e.g. rpc for eip155:8453

# ── Legacy / enforcement routers (optional, gate-oriented only) ─
X402_PAY_TO=                         # OPTIONAL  legacy default EVM receiving address
X402_EVM_PAY_TO=                     # OPTIONAL
X402_SOL_PAY_TO=                     # OPTIONAL
X402_BTC_PAY_TO=                     # OPTIONAL
X402_TRON_PAY_TO=                    # OPTIONAL
ASTERPAY_SEPA_IBAN=                  # OPTIONAL
X402_burst_limit=5                   # OPTIONAL  enforcement burst limit
X402_burst_window=60                 # OPTIONAL  enforcement burst window (seconds)
WALLET_VAULT_PASSWORD=               # OPTIONAL  vault unlock password (if used)
RMI_MCP_API_KEY=                     # OPTIONAL  gates non-public MCP/V1 endpoints

# ── Server (used by the deployable app factory) ────────────────
X402_HOST=0.0.0.0                    # OPTIONAL
X402_PORT=8001                       # OPTIONAL
X402_DEBUG=0                         # OPTIONAL  "1" → uvicorn --reload / verbose

# ── W1-W6: protocol version, webhooks, spending limits ──────────────────
# Wire format version: 1 (default) or 2 (spec-canonical v2 PaymentRequired).
X402_PROTOCOL_VERSION=1
# Merchant webhook: signed payment events (payment.verified / payment.settled).
# Deliveries carry X-Coffer-Event + X-Coffer-Signature (HMAC-SHA256 of body).
#X402_WEBHOOK_URL=https://merchant.example/hook
#X402_WEBHOOK_SECRET=change-me
# Spending controls (per-caller; unset = unrestricted).
#X402_MAX_PER_PAYMENT_ATOMIC=1000000
#X402_MAX_WINDOW_SPEND_ATOMIC=10000000
#X402_SPEND_WINDOW_SECONDS=3600
#X402_MAX_PAYMENTS_PER_WINDOW=100
# Per-caller request rate limiting (requests/minute; unset = off).
#X402_RATE_LIMIT_PER_MIN=120
